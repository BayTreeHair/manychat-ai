DATABASE_URL=
MANYCHAT_API_KEY=

# Primary classifier: Google AI Studio free tier.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback, used only when Gemini errors or hits its free-tier limit.
# Leave OPENROUTER_API_KEY empty to disable the fallback entirely.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

AI_TIMEOUT_MS=10000
AI_MAX_ATTEMPTS=2
DEBUG_CLASSIFY=0
PORT=3000
